# Copy this file to .env, then set a real password:
#
#   cp .env.example .env
#   chmod 600 .env
#
# Generate a real password with:
#
#   openssl rand -hex 24
#
# Prefer a hex/alphanumeric password (which `openssl rand -hex` already
# produces): this value is embedded directly into the migrate service's
# postgres:// database URL in docker-compose.yml, where characters like
# @ : / # would need URL-escaping to be parsed correctly.
#
# Never commit .env — it's gitignored. The placeholder below is not a
# real password and must not be used as one.
POSTGRES_PASSWORD=changeme-replace-with-openssl-rand-hex-24

# ---------------------------------------------------------------------------
# Pegasus service (cmd/pegasus) — every setting, shown commented out at its
# default. Uncomment to override. Precedence: environment (this file, via
# docker compose env_file) > optional JSON config file > default. The only
# secret is POSTGRES_PASSWORD above; it is never read from the config file.
# See README.md "Configuration" for details.
# ---------------------------------------------------------------------------

# Optional JSON config file path (keys: setting name lower-cased without the
# PEGASUS_ prefix, e.g. "db_host"). Unknown keys are an error.
# PEGASUS_CONFIG_FILE=

# Postgres connection. docker-compose.yml forces PEGASUS_DB_HOST=postgres
# and PEGASUS_DB_PORT=5432 inside the container.
# PEGASUS_DB_HOST=localhost
# PEGASUS_DB_PORT=5432
# PEGASUS_DB_NAME=pegasus
# PEGASUS_DB_USER=pegasus
# PEGASUS_DB_SSLMODE=disable
# Timeout for the startup connect + ping.
# PEGASUS_DB_CONNECT_TIMEOUT=5s

# Costguard gateway. Outside docker the default is http://localhost:8080;
# docker-compose.yml defaults it to http://host.docker.internal:8080.
# PEGASUS_COSTGUARD_URL=http://localhost:8080
# X-Costguard-Agent attribution tag.
# PEGASUS_COSTGUARD_AGENT=pegasus
# Per-request HTTP timeout for Costguard calls.
# PEGASUS_COSTGUARD_TIMEOUT=1m0s
# Wait before transcription's single retry after a Costguard 502.
# PEGASUS_COSTGUARD_TRANSCRIPTION_RETRY_BACKOFF=30s

# Voice transcription: escalate to OpenAI when mean avg_logprob is below
# this (must be negative; Arabic always escalates).
# PEGASUS_TRANSCRIPTION_CONFIDENCE_THRESHOLD=-0.7
# Costguard provider name used for escalated transcription calls.
# PEGASUS_TRANSCRIPTION_OPENAI_PROVIDER_HINT=openai_primary

# Comma-separated sender IDs (e.g. WhatsApp JIDs) that are Marco himself.
# Set this before enabling any live source.
# PEGASUS_SELF_EXTERNAL_IDS=

# Live-window idle flush: flush after this long with no new message, checked
# every poll interval.
# PEGASUS_LIVE_WINDOW_FLUSH_AFTER=5m0s
# PEGASUS_LIVE_WINDOW_FLUSH_POLL_INTERVAL=30s

# Re-extract all processed=false messages in the background at startup.
# Do not start the service while a bulk import is mid-flight.
# PEGASUS_RECOVER_ON_START=true

# Health server (/healthz, /readyz). docker-compose.yml sets 0.0.0.0:8095
# inside the container and publishes it on 127.0.0.1:8095 only.
# PEGASUS_HTTP_ADDR=127.0.0.1:8095
# Overall graceful-shutdown bound (must exceed the 30s final flush;
# compose's stop_grace_period is 90s).
# PEGASUS_SHUTDOWN_TIMEOUT=1m0s
