# Copy this file to .env, then set a real password:
#
#   cp .env.example .env
#   chmod 600 .env
#
# Generate a real password with:
#
#   openssl rand -hex 24
#
# Prefer a hex/alphanumeric password (which `openssl rand -hex` already
# produces): this value is embedded directly into the migrate service's
# postgres:// database URL in docker-compose.yml, where characters like
# @ : / # would need URL-escaping to be parsed correctly.
#
# Never commit .env — it's gitignored. The placeholder below is not a
# real password and must not be used as one.
POSTGRES_PASSWORD=changeme-replace-with-openssl-rand-hex-24
